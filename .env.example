# Kopieren nach .env und anpassen

# Port der Weboberfläche auf diesem Rechner
APRS_STATS_PORT=8092

# Passwort der Datenbank (nur intern im Stack verwendet, Pflicht).
# Nur Buchstaben und Ziffern verwenden (steht auch in der Verbindungs-URL).
# Erzeugen z. B. mit: openssl rand -hex 16
POSTGRES_PASSWORD=

# APRS-IS: Login und Passcode. Für reines Mitlesen genügt Passcode -1.
# Zum Publizieren einer Bake (Tab "Bake") braucht es dein Rufzeichen und deinen
# persönlichen Passcode; Baken sind dann nur für dieses Rufzeichen möglich.
# Leer = zuerst eingetragenes Rufzeichen wird als Login verwendet.
# Den Passcode nur hier in .env eintragen, nie in docker-compose.yml.
APRS_IS_LOGIN=
APRS_IS_PASSCODE=-1
APRS_IS_SERVER=rotate.aprs2.net
APRS_IS_PORT=14580

# Auswertung
TZ=Europe/Zurich
# Pause, nach der eine neue Fahrt beginnt (Minuten)
TRIP_GAP_MINUTES=20
# Schnellere Sprünge zwischen zwei Positionen gelten als GPS-Fehler (km/h)
MAX_PLAUSIBLE_KMH=250

# Gemeinde- und Kantonsgrenzen (swissBOUNDARIES3D von swisstopo, rund 37 MB):
# beim ersten Start automatisch laden. 0 = nur auf Knopfdruck im Tab "Gemeinden".
BOUNDARIES_AUTOLOAD=1

# Namensvorschläge für Orte (nur auf Knopfdruck, schickt die Koordinaten des Orts an Nominatim).
# Eigene Nominatim-Instanz möglich. NOMINATIM_EMAIL ist optional und wird als Kontakt mitgeschickt.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
